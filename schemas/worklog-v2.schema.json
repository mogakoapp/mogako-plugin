{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mogako.xyz/schemas/worklog-v2.schema.json",
  "title": "Mogako Worklog Checkpoint v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceRecordId",
    "sourceClient",
    "generatedAt",
    "timeZoneId",
    "localDate",
    "summary",
    "completed",
    "changedFiles",
    "nextActions",
    "blockers"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "sourceRecordId": { "type": "string", "format": "uuid" },
    "sourceClient": {
      "type": "string",
      "enum": ["CODEX", "CLAUDE_CODE", "ANTIGRAVITY", "MANUAL_CLI"]
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "timeZoneId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "localDate": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "completed": { "$ref": "#/$defs/textItems" },
    "changedFiles": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "nextActions": { "$ref": "#/$defs/textItems" },
    "blockers": { "$ref": "#/$defs/textItems" }
  },
  "$defs": {
    "textItems": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    }
  }
}
